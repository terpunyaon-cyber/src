local function GetPlayerNames()
	local t={}
	for _,p in pairs(Players:GetPlayers()) do
		if p~=LocalPlayer then table.insert(t,p.Name) end
	end
	return t
end

MainSection:Dropdown({
	Title="Save Friend",
	Values=GetPlayerNames(),
	Multi=true,
	Default={},
	Callback=function(sel)
		for _,p in pairs(Players:GetPlayers()) do p:SetAttribute("SilentAimIgnore",false) end
		for _,n in pairs(sel) do
			local p=Players:FindFirstChild(n)
			if p then p:SetAttribute("SilentAimIgnore",true) end
		end
	end
})
