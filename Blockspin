				tracer.Line.From = Vector2.new(fromPos.X, fromPos.Y)
				tracer.Line.To = Vector2.new(toPos.X, toPos.Y)
				
				-- ทำให้เส้นจางลงเมื่อใกล้หมดอายุ
				local age = tick() - tracer.Created
				local alpha = 1 - (age / bulletTracerLifetime)
				tracer.Line.Transparency = 1 - (alpha * 0.7)
			else
				tracer.Line.Visible = false
			end
		end
	end
end)







