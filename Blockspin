-- ====== BULLET TRACER (เส้นกระสุน) ======
local bulletTracers = {}  
local maxBulletTracers = 15
local bulletTracerLifetime = 0.2  

local function CreateBulletTracer()
	local line = Drawing.new("Line")
	line.Color = Color3.fromRGB(255, 100, 255) 
	line.Thickness = 2.5  
	line.Transparency = 0.3
	line.Visible = true
	return {
		Line = line,
		Created = tick(),
		From = nil,
		To = nil
	}
end

local function CleanupBulletTracers()
	local currentTime = tick()
	for i = #bulletTracers, 1, -1 do
		local tracer = bulletTracers[i]
		if currentTime - tracer.Created > bulletTracerLifetime then
			tracer.Line:Remove()
			table.remove(bulletTracers, i)
		end
	end
end

-- ====== FUNCTIONS ======
local function GetClosestTarget()
	local closest, shortest = nil, math.huge
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer
			and not plr:GetAttribute("SilentAimIgnore")
			and plr.Character
			and plr.Character:FindFirstChild("Head") then

			local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
			if onScreen then
				local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
				if dist < FOV and dist < shortest then
					shortest = dist
					closest = plr
				end
			end
		end
	end

	return closest
end

local function GetGunMuzzlePosition()
	if not LocalPlayer.Character then return nil end
	for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
		if (tool:IsA("Tool") or tool:IsA("Model")) and table.find(GunNames, tool.Name) then
			-- หา Handle หรือจุดที่กระสุนออก
			local handle = tool:FindFirstChild("Handle") or tool:FindFirstChild("MainPart")
			if handle then
				-- ลองหาจุดที่กระสุนออก (Muzzle หรือ Flash)
				local muzzle = tool:FindFirstChild("Muzzle") or tool:FindFirstChild("Flash")
				if muzzle then
					return muzzle.WorldPosition
				else
					-- ถ้าไม่เจอจุด Muzzle ให้ใช้ตำแหน่ง Handle + offset
					return handle.CFrame * CFrame.new(0, 0, -1.8)  -- offset ออกไปข้างหน้า
				end
			end
		end
	end
	
	return nil
end

local function IsHoldingAllowedGun(args)
	local ok, weapon = pcall(function()
		return args[3]
	end)

	if ok and typeof(weapon) == "Instance" and table.find(GunNames, weapon.Name) then
		return true
	end

	if LocalPlayer.Character then
		for _, v in pairs(LocalPlayer.Character:GetChildren()) do
			if (v:IsA("Tool") or v:IsA("Model"))
				and table.find(GunNames, v.Name) then
				return true
			end
		end
	end

	return false
end

-- ====== SILENT AIM HOOK ======
local send = ReplicatedStorage.Remotes.Send
local oldFire
oldFire = hookfunction(send.FireServer, function(self, ...)
	local args = {...}

	if SilentAimEnabled and IsHoldingAllowedGun(args) then
		local target = GetClosestTarget()
		if target and target.Character and target.Character:FindFirstChild("Head") then
			local head = target.Character.Head
			args[4] = CFrame.new(math.huge, math.huge, math.huge)
			args[5] = {
				[1] = {
					[1] = {
						Instance = head,
						Position = head.Position
					}
				}
			}
			
			local muzzlePos = GetGunMuzzlePosition()
			if muzzlePos then
				local tracer = CreateBulletTracer()
				tracer.From = muzzlePos
				tracer.To = head.Position
				
				table.insert(bulletTracers, tracer)
				if #bulletTracers > maxBulletTracers then
					bulletTracers[1].Line:Remove()
					table.remove(bulletTracers, 1)
				end
			end
		end
	end

	return oldFire(self, unpack(args))
end)

